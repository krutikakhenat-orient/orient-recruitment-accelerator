# Secrets (local environment files are never committed)
.env.local

# CDK Build Artifacts
cdk/cdk.out/
cdk/node_modules/

# CLI Internals
.cli/*

# Ephemeral Staging
.cache/*

# Exception: Commit the State
!.cli/deployed-state.json

# Packaging output from `agentcore package` / `agentcore deploy`
*.zip
interview_agent/
