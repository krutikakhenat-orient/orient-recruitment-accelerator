# Copy to .env for local development. Do not commit .env. Never put access keys here.
# In AgentCore, set these as runtime environment variables; AWS credentials come from the execution role.

INTERVIEW_AGENT_ENVIRONMENT=local
INTERVIEW_AGENT_ADAPTERS=fake            # fake | aws

AWS_PROFILE=default                      # local only
AWS_DEFAULT_REGION=ap-south-1
INTERVIEW_AGENT_AWS_REGION=ap-south-1

INTERVIEW_AGENT_LLM_MODEL_ID=openai.gpt-oss-120b-1:0
INTERVIEW_AGENT_LLM_REASONING_EFFORT=low

INTERVIEW_AGENT_TRANSCRIBE_LANGUAGE=en-IN
INTERVIEW_AGENT_POLLY_VOICE_ID=Kajal
INTERVIEW_AGENT_POLLY_LANGUAGE_CODE=en-IN
INTERVIEW_AGENT_POLLY_ENGINE=neural
# INTERVIEW_AGENT_POLLY_REGION=us-east-1   # needed for generative voices such as Arjun

INTERVIEW_AGENT_MAX_INTERVIEW_SECONDS=1800
INTERVIEW_AGENT_MAX_QUESTIONS=8
INTERVIEW_AGENT_MAX_FOLLOWUPS_PER_QUESTION=1
INTERVIEW_AGENT_ENDPOINT_SILENCE_MS=800
INTERVIEW_AGENT_ALLOW_TEXT_INPUT=true

INTERVIEW_AGENT_OUTPUT_DIR=./out
# INTERVIEW_AGENT_S3_BUCKET=
# INTERVIEW_AGENT_S3_PREFIX=interviews/
# INTERVIEW_AGENT_WEBHOOK_URL=
# INTERVIEW_AGENT_WEBHOOK_SECRET=
