# Orient Recruitment Accelerator — environment template (local development).
# Copy to deploy/.env and adjust. NEVER commit a real .env or production secrets.

# --- Environment ---
ORA_ENVIRONMENT=development
ORA_APP_NAME=Orient Recruitment Accelerator

# --- Database (compose service name 'postgres') ---
ORA_DATABASE_URL=postgresql+psycopg://ora:ora@postgres:5432/ora
POSTGRES_USER=ora
POSTGRES_PASSWORD=ora
POSTGRES_DB=ora

# --- Security / tokens ---
# For production, generate a strong random value (>=32 chars) and keep it in a secret store.
ORA_JWT_SECRET=dev-only-change-me-please-use-32chars+
ORA_ACCESS_TOKEN_TTL_SECONDS=900
ORA_REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Auth hardening ---
ORA_MAX_FAILED_LOGINS=5
ORA_LOCKOUT_SECONDS=900

# --- CORS (comma-separated; must not include localhost in production) ---
ORA_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Feature flags ---
ORA_LLM_ADAPTER_ENABLED=false

# --- Object storage (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Redis (Dramatiq broker) ---
ORA_REDIS_URL=redis://redis:6379/0
